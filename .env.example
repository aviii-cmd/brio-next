# ============================================================
# Brio — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Supabase project URL (found in: Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (found in: Project Settings → API)
# This key is safe to expose in the browser — it only has
# access that your Row Level Security policies allow.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# NEVER add the service role key here — it bypasses RLS and
# must only be used in server-side environments.
# ============================================================
